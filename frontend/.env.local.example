# Copy to frontend/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Base map style (no key needed). Alternatives: https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Default base map: satellite (Esri World Imagery, no key) or streets (OpenFreeMap)
NEXT_PUBLIC_MAP_BASE=satellite
# Optional: MapTiler key for production-grade satellite hybrid tiles (https://cloud.maptiler.com)
# NEXT_PUBLIC_MAPTILER_KEY=
