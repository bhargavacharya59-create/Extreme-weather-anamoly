# Copy to backend/.env and fill in. NEVER commit backend/.env.

# --- Gemini (AI alert wording + Copilot). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Free tier running out (HTTP 429)? Try GEMINI_MODEL=gemini-2.5-flash-lite (higher free limits).
# Set WP_USE_GEMINI=0 to switch Gemini off completely (template alerts + offline Copilot).
WP_USE_GEMINI=1
# 1 = also let Gemini write the ~50 automatic drafts/summaries on every pipeline run (uses quota fast).
WP_GEMINI_IN_PIPELINE=0

# --- Runtime
WP_CORS_ORIGINS=http://localhost:3000
WP_RUN_ON_STARTUP=1
WP_SEED=42
WP_SCENARIO_MONTH=9
# Census 2011 -> present population scaling (RGI projection, all-India approx.)
WP_POP_PROJECTION_FACTOR=1.18
# Secret used to sign demo login tokens (any long random string)
WP_AUTH_SECRET=change-me-to-a-long-random-string

# --- Real data (optional, see docs/DATASETS.md)
# Copernicus CDS: configure ~/.cdsapirc as described at https://cds.climate.copernicus.eu/how-to-api
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=

# --- Notifications (optional; without these, deliveries are logged as "simulated")
WP_SMS_PROVIDER=log          # log | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WP_EMAIL_PROVIDER=log        # log | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
